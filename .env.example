# .env.example - every setting the Elusion API reads, with made-up values.
#
# Copy it to .env beside app.py for a local server, or to
# /etc/elusion/elusion.env on the live one, and uncomment what you need.
# Every line is commented out on purpose, so a copy taken as it is sets
# nothing. A real environment variable always wins over the file.
#
# test_deploy.py fails if the code reads a setting this file does not list,
# and wsgi.py checks them all before the server starts (envfile.check_env).
# DEPLOY.md says what each one is for. Never put a real password here: this
# file is in the repository.

# --- Who runs it --------------------------------------------------------------
# ELUSION_OWNER=your_username
# ELUSION_CO_OWNERS=a_friend,another_friend

# --- Where things are ---------------------------------------------------------
# ELUSION_DB=/var/lib/elusion/elusion.db
# ELUSION_GAMEDATA=/opt/elusion/api/gamedata.json
# ELUSION_BACKUP_DIR=/var/backups/elusion

# --- In front of it -----------------------------------------------------------
# Proxies between the internet and this app: 1 behind nginx, 0 with none.
# ELUSION_TRUSTED_PROXIES=1
# ELUSION_RATE_LIMIT=600 per minute

# --- Mail: recovery codes and staff login codes -------------------------------
# ELUSION_SMTP_HOST=smtp.example.com
# ELUSION_SMTP_PORT=587
# ELUSION_SMTP_USER=noreply@example.com
# ELUSION_SMTP_PASSWORD=typed-on-the-server-only
# ELUSION_MAIL_FROM="Elusion RPG <noreply@example.com>"
# Off only to get back in when mail has broken (DEPLOY.md):
# ELUSION_STAFF_LOGIN_CODES=off

# --- Presence: the live socket ------------------------------------------------
# ELUSION_PRESENCE_HOST=127.0.0.1
# ELUSION_PRESENCE_PORT=5001
# ELUSION_PRESENCE_URL=wss://example.com/ws/presence
# ELUSION_BOOKS=on
# ELUSION_TRANSFER_GIB=1000
# Send each game only the players near it (0.89.0); off sends everyone everything:
# ELUSION_NEAR=on

# --- Party voice: the TURN relay ----------------------------------------------
# ELUSION_TURN_KEY_ID=example_key_id_123
# ELUSION_TURN_KEY_TOKEN=typed-on-the-server-only

# --- This computer only: wsgi.py refuses these on a server --------------------
# ELUSION_DEBUG=1
# ELUSION_MAIL_CONSOLE=1
# ELUSION_VOICE_DIRECT=on
# A new database connection per request, for measuring (swarm.py):
# ELUSION_DB_FRESH=1
